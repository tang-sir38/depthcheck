cff-version: 1.2.0
message: "If you use depthcheck, please cite the software release and the accompanying paper."
title: "depthcheck: depth-computable component of the single-cell Fano factor"
version: 1.0.0
date-released: "2026-10-18"
license: MIT
type: software
authors:
  - family-names: Tang
    given-names: Chaohua
    orcid: "https://orcid.org/0009-0004-7080-8993"
